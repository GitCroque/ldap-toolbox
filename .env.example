# LDAP Connection
# The password for binding to the LDAP server
LDAP_PASSWORD=your-secure-password

# Alerting - Slack
# Webhook URL for Slack notifications
SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Alerting - Email
# SMTP credentials for email notifications
SMTP_USER=smtp-user
SMTP_PASSWORD=smtp-password

# Integrations - n8n
# Webhook URL for n8n automation platform
N8N_WEBHOOK=https://n8n.example.com/webhook/ldap

# Optional: Override config file path
# CONFIG_PATH=/path/to/config.yaml

# Optional: Override log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO

# Optional: Override backup directory
# BACKUP_DIR=/path/to/backups

# Optional: Override reports directory
# REPORTS_DIR=/path/to/reports
